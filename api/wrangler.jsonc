// Colander on Cloudflare: one Worker for the website and the API (docs/hosting-plan.md section 2).
// Production is the top level; `env.staging` repeats every binding because Wrangler does not
// inherit bindings, vars or secrets into named environments.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "colander",
	"main": "src/index.ts",
	// The newest date the pinned workerd supports. Advance it with Wrangler and rerun the tests.
	"compatibility_date": "2026-10-01",
	// The site and API, and the admin host behind Cloudflare Access (docs/deploy.md step 6a).
	"routes": [
		{ "pattern": "getcolander.com", "custom_domain": true },
		{ "pattern": "admin.getcolander.com", "custom_domain": true }
	],
	// Only the custom domains serve the Worker: a workers.dev or preview URL would bypass Access on
	// staging and split the edge cache.
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": "../web/build",
		"binding": "ASSETS",
		// /definition serves definition.html, as the Go server's lookup did.
		"html_handling": "auto-trailing-slash",
		// Unknown paths get build/404.html (a copy of the SPA shell) with status 404.
		"not_found_handling": "404-page",
		// /200 and /404 are the SPA shells, which html_handling would serve as pages with status 200;
		// the Worker answers them as not found. The _redirects rewrites to /200 stay inside Static
		// Assets, so source and appeal pages still get the shell. The home page and the admin pages
		// run the Worker first, so it checks Access on the admin host and sends /admin there.
		"run_worker_first": ["/v1/*", "/ops/*", "/healthz", "/__dev/*", "/200", "/404", "/", "/admin", "/admin/*"]
	},
	// Workers Cache in front of the list and public GETs. Responses carry explicit headers (src/http.ts).
	"cache": { "enabled": true, "cross_version_cache": true },
	"durable_objects": { "bindings": [{ "name": "STORE", "class_name": "Store" }] },
	// Forward-only. CI must refuse deleted_classes, renamed_classes and transferred_classes for Store.
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }],
	"r2_buckets": [
		{ "binding": "LISTS", "bucket_name": "colander-lists" },
		{ "binding": "BACKUPS", "bucket_name": "colander-backups" }
	],
	"send_email": [
		{ "name": "EMAIL" },
		// Placeholder: replace with the ops address verified in Email Routing (hosting plan section 8).
		{ "name": "ALERTS", "destination_address": "ops-alerts@getcolander.com" }
	],
	// Burst shield for cache misses, keyed by the salted IP hash. Counts per location, so it is not exact.
	"ratelimits": [{ "name": "MISSES", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
	// Watchdog every 5 minutes, analytics pull hourly.
	"triggers": { "crons": ["*/5 * * * *", "7 * * * *"] },
	// Scoring passes and dumps run inside the Store; the default 30 s CPU cap is too tight for them.
	"limits": { "cpu_ms": 300000 },
	"rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
	// Invocation logs and traces record request URLs and headers, so both stay off (contract 8).
	// Code logs the route pattern, status and duration only.
	"observability": {
		"enabled": true,
		"redact_query_string": true,
		"logs": { "enabled": true, "invocation_logs": false },
		"traces": { "enabled": false }
	},
	"vars": {
		"PUBLIC_URL": "https://getcolander.com",
		"COLANDER_DEV": "",
		// The watchdog's recipient: exactly the ALERTS destination_address above.
		"ALERT_ADDRESS": "ops-alerts@getcolander.com",
		// The getcolander.com zone ID, for the hourly list request count. Empty skips that pull.
		"CF_ZONE_ID": "",
		// Sender of sign-in, appeal and billing mail, on the domain onboarded to Email Sending (and Resend).
		"COLANDER_MAIL_FROM": "Colander <hello@getcolander.com>",
		// Price IDs of the $3 monthly and $30 yearly Plus prices; checkout answers 503 until they are set.
		"STRIPE_PRICE_PLUS_MONTHLY": "",
		"STRIPE_PRICE_PLUS_YEARLY": "",
		// Plus checkout with Stripe Managed Payments as merchant of record; "0" turns it off.
		"STRIPE_MANAGED_PAYMENTS": "",
		// YouTube Data API units the Worker may spend per Pacific day. Both environments use one Google
		// Cloud project's 10,000 units, so their budgets together stay at 8,000.
		"YOUTUBE_DAILY_UNITS": "7000",
		// The admin host and its Cloudflare Access application: the team domain
		// (<team>.cloudflareaccess.com) and the application's AUD tag. Until both are set, every
		// admin-host request answers 403 (docs/deploy.md step 6a).
		"ADMIN_HOST": "admin.getcolander.com",
		"CF_ACCESS_TEAM_DOMAIN": "",
		"CF_ACCESS_AUD": "",
		// The ops channel takes GitHub Actions OIDC tokens from workflows of this repository on main,
		// in this GitHub environment (docs/deploy.md, The ops channel).
		"OPS_GITHUB_REPOSITORY": "rudecompany/colander",
		"OPS_GITHUB_REPOSITORY_ID": "1403629038",
		"OPS_GITHUB_ENVIRONMENT": "production"
	},
	"secrets": { "required": ["COLANDER_SIGNING_KEY", "IP_SALT"] },
	"env": {
		"staging": {
			"name": "colander-staging",
			"routes": [
				{ "pattern": "staging.getcolander.com", "custom_domain": true },
				{ "pattern": "staging-admin.getcolander.com", "custom_domain": true }
			],
			"workers_dev": false,
			"preview_urls": false,
			"durable_objects": { "bindings": [{ "name": "STORE", "class_name": "Store" }] },
			"r2_buckets": [
				{ "binding": "LISTS", "bucket_name": "colander-staging-lists" },
				{ "binding": "BACKUPS", "bucket_name": "colander-staging-backups" }
			],
			"send_email": [
				{ "name": "EMAIL" },
				{ "name": "ALERTS", "destination_address": "ops-alerts@getcolander.com" }
			],
			"ratelimits": [{ "name": "MISSES", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }],
			"triggers": { "crons": ["*/5 * * * *", "7 * * * *"] },
			"vars": {
				"PUBLIC_URL": "https://staging.getcolander.com",
				"COLANDER_DEV": "",
				"ALERT_ADDRESS": "ops-alerts@getcolander.com",
				"CF_ZONE_ID": "",
				"COLANDER_MAIL_FROM": "Colander <hello@getcolander.com>",
				"STRIPE_PRICE_PLUS_MONTHLY": "",
				"STRIPE_PRICE_PLUS_YEARLY": "",
				"STRIPE_MANAGED_PAYMENTS": "",
				"YOUTUBE_DAILY_UNITS": "1000",
				"ADMIN_HOST": "staging-admin.getcolander.com",
				"CF_ACCESS_TEAM_DOMAIN": "",
				"CF_ACCESS_AUD": "",
				"OPS_GITHUB_REPOSITORY": "rudecompany/colander",
				"OPS_GITHUB_REPOSITORY_ID": "1403629038",
				"OPS_GITHUB_ENVIRONMENT": "staging"
			},
			"secrets": { "required": ["COLANDER_SIGNING_KEY", "IP_SALT"] }
		}
	}
}
