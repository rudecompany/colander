{
  "name": "@colander/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "node ../packages/shared/scripts/gen-inpage-tokens.ts --check && vite build",
    "postbuild": "node -e \"require('node:fs').copyFileSync('build/200.html', 'build/404.html')\"",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && node scripts/lint-tokens.ts",
    "test": "playwright test",
    "screenshots": "SCREENSHOTS=1 playwright test screenshots"
  },
  "dependencies": {
    "@colander/shared": "workspace:*",
    "@lucide/svelte": "^1.51.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.1",
    "linkedom": "^0.18.13",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.2"
  }
}
