{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Colander seed source registry",
	"description": "Every outside dataset Colander may read (docs/contracts.md section 14). The shape only: validateEntry in seeds.ts adds the license, use and clearance rules, and CI runs both through scripts/check-seeds.ts.",
	"type": "object",
	"required": ["entries"],
	"additionalProperties": false,
	"properties": {
		"$schema": { "type": "string" },
		"entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
	},
	"$defs": {
		"date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
		"url": { "type": "string", "pattern": "^https://\\S+$" },
		"entry": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"name",
				"aliases",
				"homepage",
				"platforms",
				"license",
				"license_url",
				"attribution",
				"collection",
				"scraped",
				"use",
				"format",
				"sha256",
				"upstream",
				"expires_after_days",
				"calibration",
				"dev_only",
				"clearance"
			],
			"properties": {
				"id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,62}$", "description": "Stable ID, also the private object key seeds/<id>.json" },
				"name": { "type": "string", "minLength": 1, "description": "The dataset's own name, as /credits shows it" },
				"aliases": {
					"type": "array",
					"uniqueItems": true,
					"items": { "type": "string", "minLength": 4 },
					"description": "Other names people know the dataset by, such as a short name or its domain. Public text may contain none of them; a third-party dataset needs at least one"
				},
				"homepage": { "$ref": "#/$defs/url" },
				"platforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["yt", "tt", "ig", "fb"] } },
				"license": { "type": "string", "minLength": 1, "description": "SPDX identifier, LicenseRef-written-grant or LicenseRef-Colander-internal" },
				"license_url": { "oneOf": [{ "$ref": "#/$defs/url" }, { "type": "null" }] },
				"attribution": { "type": ["string", "null"], "minLength": 1, "description": "The exact credit the license requires, or null" },
				"collection": { "type": "string", "minLength": 1, "description": "How the maintainer collected the list, citing their README or a statement" },
				"scraped": { "type": ["boolean", "null"], "description": "null until the maintainer has said" },
				"use": { "enum": ["lead", "seed", "frame"] },
				"format": { "enum": ["lines", "ubo", "soul-over-ai"] },
				"sha256": { "oneOf": [{ "type": "string", "pattern": "^[0-9a-f]{64}$" }, { "type": "null" }] },
				"upstream": {
					"type": "object",
					"additionalProperties": false,
					"required": ["ref", "date"],
					"properties": {
						"ref": { "type": ["string", "null"], "minLength": 1 },
						"date": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] }
					}
				},
				"expires_after_days": { "type": "integer", "minimum": 1, "maximum": 730 },
				"calibration": {
					"oneOf": [
						{ "type": "null" },
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["report", "groups"],
							"properties": {
								"report": { "$ref": "#/$defs/date" },
								"groups": {
									"type": "array",
									"minItems": 1,
									"items": {
										"type": "object",
										"additionalProperties": false,
										"required": ["group", "n", "ai", "slop"],
										"properties": {
											"group": { "type": "string", "minLength": 1 },
											"n": { "type": "integer", "minimum": 0 },
											"ai": { "type": "integer", "minimum": 0 },
											"slop": { "type": "integer", "minimum": 0 }
										}
									}
								}
							}
						}
					]
				},
				"dev_only": { "type": "boolean" },
				"clearance": {
					"type": "object",
					"additionalProperties": false,
					"required": ["status", "by", "at"],
					"properties": {
						"status": { "enum": ["pending", "cleared", "refused", "revoked"] },
						"by": { "type": ["string", "null"], "minLength": 1, "description": "The owner's GitHub login" },
						"at": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] }
					}
				}
			}
		}
	}
}
