{
  "name": "@colander/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": { "types": "./src/index.ts", "svelte": "./src/index.ts", "default": "./src/index.ts" },
    "./verdicts": "./src/verdicts.ts",
    "./glyphs": "./src/glyphs.ts",
    "./api": "./src/api.ts",
    "./copy": "./src/copy.ts",
    "./layers": "./src/layers.ts",
