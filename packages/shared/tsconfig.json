{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"noEmit": true,
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		]
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.svelte",
		"test/**/*.ts",
		"vitest.config.ts"
	]
}
